# Shared Config
NODE_ENV=development
JWT_SECRET=supersecretjwtkey12345
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=supersecretrefreshkey12345
REFRESH_TOKEN_EXPIRES_IN=7d
INTERNAL_API_KEY=supersecretinternalkey

# Service URLs (used by gateway and inter-service calls)
AUTH_SERVICE_URL=http://localhost:5001
USER_SERVICE_URL=http://localhost:5002
EXTINGUISHER_SERVICE_URL=http://localhost:5003
INSPECTION_SERVICE_URL=http://localhost:5004
REPORT_SERVICE_URL=http://localhost:5005
NOTIFICATION_SERVICE_URL=http://localhost:5006

# Auth Service
AUTH_PORT=5001
AUTH_DATABASE_URL=postgresql://postgres:kk123%2C4@localhost:5432/tzw_auth_db

# User Management Service
USER_PORT=5002
USER_DATABASE_URL=postgresql://postgres:kk123%2C4@localhost:5432/tzw_user_db

# Extinguisher Service
EXT_PORT=5003
EXT_DATABASE_URL=postgresql://postgres:kk123%2C4@localhost:5432/tzw_ext_db

# Inspection Service
INSP_PORT=5004
INSP_DATABASE_URL=postgresql://postgres:kk123%2C4@localhost:5432/tzw_insp_db

# Report Service
RPT_PORT=5005
RPT_DATABASE_URL=postgresql://postgres:kk123%2C4@localhost:5432/tzw_rpt_db

# Notification Service
NOTIF_PORT=5006
NOTIF_DATABASE_URL=postgresql://postgres:kk123%2C4@localhost:5432/tzw_notif_db

# API Gateway
GATEWAY_PORT=5000
